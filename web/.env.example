# The deployed Found It contract on GenLayer Studio (chain 61999). Empty: lib/config.ts DEMO_CONTRACT is used.
# With both empty every page says the contract is not deployed yet; NEXT_PUBLIC_MOCK=1 still shows the whole site.
NEXT_PUBLIC_CONTRACT=

# 1: the site runs on an in-memory copy of the contract (lib/chain-mock.ts), judging with a word count where the
# validators would ask their models; no wallet and no network. For local work and for showing the pages; never for
# a public deployment.
NEXT_PUBLIC_MOCK=0

# The public address of the site, used for the links in shared-link previews.
NEXT_PUBLIC_SITE_URL=

# The public source repository (https://github.com/<owner>/<name>) for the footer's Source link. On Vercel the
# repository the site was built from is used when this is empty.
NEXT_PUBLIC_REPO_URL=

# Server only. A throwaway Studio test key: the demo owner (it keeps the three demo items posted with sealed marks
# and reveals, reseals and reposts them when /api/demo/* asks) and the demo finder (it claims a visitor's item with
# one of three fixed descriptions). tools/open-demo.mjs posts the items with it. Never a key that holds anything
# real. Pasted with or without 0x, with or without quotes. Unset: the site works, and GET /api/demo/status says
# exactly why the demo owner is away.
DEMO_OWNER_KEY=
